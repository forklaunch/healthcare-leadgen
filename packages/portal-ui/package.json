{
  "name": "@ideas-portal/ui",
  "version": "0.1.0",
  "description": "Sealed Ideas Portal UI: themable, organization-configurable portal and admin components published from the main repo and consumed by per-customer frontends.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "publish:frontends": "pnpm build && pnpm pack --pack-destination ../../../ideas-frontends/vendor",
    "clean": "rm -rf dist node_modules"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3"
  }
}
