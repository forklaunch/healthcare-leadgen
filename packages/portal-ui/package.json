{
  "name": "@forklaunch/healthcare-leadgen-ui",
  "version": "0.1.4",
  "description": "Sealed Healthcare Leadgen portal UI: themable, organization-configurable portal and admin components published from the healthcare-leadgen repo and consumed by per-customer frontends.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forklaunch/healthcare-leadgen.git",
    "directory": "packages/portal-ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "healthcare",
    "portal",
    "forklaunch",
    "react"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "pack:template": "pnpm build && pnpm pack --pack-destination ../../../template-healthcare-leadgen/vendor",
    "clean": "rm -rf dist node_modules"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3"
  }
}
