{
  "name": "@uchicago-ideas/iam",
  "version": "0.1.0",
  "type": "module",
  "description": "uchicago-ideas service implementation for iam, providing identity and access management APIs",
  "keywords": [],
  "license": "MIT",
  "author": "Rohin Bhargava",
  "main": "./dist/index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "tsgo -b",
    "clean": "rm -rf dist lib pnpm.lock.yaml tsconfig.tsbuildinfo node_modules",
    "dev": "pnpm migrate:up && pnpm tsx watch server.ts",
    "dev:local": "DOTENV_FILE_PATH=.env.local pnpm migrate:up && DOTENV_FILE_PATH=.env.local pnpm tsx watch server.ts",
    "docs": "typedoc --out docs *",
    "format": "biome format --write .",
    "lint": "oxlint --config .oxlint.config.json",
    "lint:fix": "oxlint --fix --config .oxlint.config.json",
    "migrate:create": "[ -z $DOTENV_FILE_PATH ] && export DOTENV_FILE_PATH=.env.local; NODE_OPTIONS='--import=tsx' mikro-orm migration:create",
    "migrate:down": "[ -z $DOTENV_FILE_PATH ] && export DOTENV_FILE_PATH=.env.local; NODE_OPTIONS='--import=tsx' mikro-orm migration:down",
    "migrate:init": "if [ ! -f migrations/Migration* ]; then [ -z $DOTENV_FILE_PATH ] && export DOTENV_FILE_PATH=.env.local; NODE_OPTIONS='--import=tsx' mikro-orm migration:create --initial; fi",
    "migrate:up": "[ -z $DOTENV_FILE_PATH ] && export DOTENV_FILE_PATH=.env.local; NODE_OPTIONS='--import=tsx' mikro-orm migration:up",
    "seed": "[ -z $DOTENV_FILE_PATH ] && export DOTENV_FILE_PATH=.env.local; NODE_OPTIONS='--import=tsx' mikro-orm seeder:run",
    "start": "[ -f .env.prod ] && export DOTENV_FILE_PATH=.env.prod; pnpm migrate:up && [ -f .env.prod ] && export DOTENV_FILE_PATH=.env.prod; node --import=tsx dist/server.js",
    "start:server": "[ -f .env.prod ] && export DOTENV_FILE_PATH=.env.prod; pnpm migrate:up && [ -f .env.prod ] && export DOTENV_FILE_PATH=.env.prod; node --import=tsx dist/server.js",
    "test": "pnpm vitest --passWithNoTests",
    "retention:enforce": "pnpm tsx scripts/enforce-retention.ts"
  },
  "dependencies": {
    "@forklaunch/better-auth-mikro-orm-fork": "~0.5.3",
    "@forklaunch/common": "~1.2.18",
    "@forklaunch/core": "~1.5.2",
    "@forklaunch/express": "~1.2.32",
    "@forklaunch/implementation-iam-base": "~1.0.26",
    "@forklaunch/interfaces-iam": "~1.0.25",
    "@forklaunch/infrastructure-redis": "~1.4.4",
    "@forklaunch/internal": "~1.2.18",
    "@forklaunch/universal-sdk": "~1.2.18",
    "@forklaunch/validator": "~1.2.18",
    "@mikro-orm/core": "7.0.15",
    "@mikro-orm/migrations": "7.0.15",
    "@mikro-orm/postgresql": "7.0.15",
    "@mikro-orm/seeder": "7.0.15",
    "@opentelemetry/api": "^1.9.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/qs": "^6.15.1",
    "ajv": "^8.20.0",
    "better-auth": "^1.6.10",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "pino": "^10.3.1",
    "ioredis": "^5.10.1",
    "@uchicago-ideas/core": "workspace:*",
    "@uchicago-ideas/monitoring": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@forklaunch/testing": "~1.2.18",
    "@mikro-orm/cli": "7.0.15",
    "@types/jest": "^30.0.0",
    "@types/uuid": "^11.0.0",
    "oxlint": "^0.16.6",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.19",
    "typescript-eslint": "^8.59.3",
    "eslint": "10.7.0"
  },
  "mikro-orm": {
    "manifest_paths": [
      "./mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  }
}