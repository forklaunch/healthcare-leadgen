# Copy to .env.local and fill in. Never commit .env.local.

DB_NAME=uchicago-ideas-innovations-dev
DB_HOST=localhost
DB_USER=postgresql
DB_PASSWORD=postgresql
DB_PORT=5432
NODE_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=uchicago-ideas-innovations-dev
OTEL_LEVEL=info

# 32-byte base64 key for field encryption (generate: openssl rand -base64 32)
ENCRYPTION_KEY=
HOST=localhost
PROTOCOL=http
PORT=9101
WS_PORT=11101
VERSION=v1
DOCS_PATH=/docs

REDIS_URL=redis://localhost:6379/2
JWKS_PUBLIC_KEY_URL=http://localhost:9100/api/auth/jwks
IAM_URL=http://localhost:9100
# hex secret shared with IAM (generate: openssl rand -hex 32)
HMAC_SECRET_KEY=
PORTAL_URL=http://localhost:5174
# Resend API key for access-key emails; leave blank to log emails instead
RESEND_API_KEY=

# Per-organization portal frontends (magic-link targets)
PORTAL_URL_UCHICAGO_MEDICINE=http://localhost:5174
PORTAL_URL_MCG=http://localhost:5175
PORTAL_URL_MEMORIAL_HEALTH=http://localhost:5176

# Azure AI Foundry — leave blank for an offline sample evaluation in local dev.
# FOUNDRY_ENDPOINT accepts a resource base URL (e.g. https://<resource>.services.ai.azure.com
# or https://<resource>.openai.azure.com) or a full chat-completions URL.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=
FOUNDRY_API_VERSION=2024-05-01-preview
